<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <service
      android:name=".GateService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Shows a Bible verse when the user turns on or unlocks their phone, a habit they enabled themselves." />
    </service>

    <receiver android:name=".BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- The verse screen. Own task, shown on top of the lock screen, never in Recents. -->
    <activity
      android:name=".GateActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity="${applicationId}.gate"
      android:screenOrientation="portrait"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:theme="@style/Theme.Gate" />
  </application>
</manifest>
